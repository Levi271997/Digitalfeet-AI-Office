# Copy to apps/server/.env and fill in.

# --- Claude -----------------------------------------------------------------
# API key from https://console.anthropic.com. The Agent SDK bills through the API.
ANTHROPIC_API_KEY=

# Hard spend cap for a single office task, in USD. The SDK has no limit by default.
MAX_BUDGET_USD_PER_TASK=2

# --- Server -----------------------------------------------------------------
PORT=4000
# Origin of the web app, for CORS.
WEB_ORIGIN=http://localhost:3000

# --- MCP connectors (remote HTTP servers) -----------------------------------
# A connector is only enabled when its URL is set. The SDK does not run OAuth
# for you: get a token for each service yourself and paste it here.
CLICKUP_MCP_URL=
CLICKUP_MCP_TOKEN=

MONDAY_MCP_URL=
MONDAY_MCP_TOKEN=

FIGMA_MCP_URL=
FIGMA_MCP_TOKEN=

CANVA_MCP_URL=
CANVA_MCP_TOKEN=

FIREFLIES_MCP_URL=
FIREFLIES_MCP_TOKEN=

WORDPRESS_MCP_URL=
WORDPRESS_MCP_TOKEN=

NETLIFY_MCP_URL=
NETLIFY_MCP_TOKEN=
